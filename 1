pipeline {
    agent any

    environment {
        COMPOSE_PROJECT_NAME = "ev-managementsystem"
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo 'Checkout EV Management System Code'
                checkout scm
            }
        }

        stage('Frontend Test') {
            steps {
                echo 'Testing React Frontend'
                sh '''
                cd frontend
                npm install
                CI=true npm test -- --watchAll=false
                '''
            }
        }

        stage('Backend Test') {
            steps {
                echo 'Testing Flask Backend'
                sh '''
                cd backend
                python3 -m pip install -r requirements.txt
                python3 -m unittest discover || true
                '''
            }
        }

        stage('Docker Build Test') {
            steps {
                echo 'Building Docker Images'
                sh '''
                docker compose build
                '''
            }
        }

        stage('Stop Old Deployment') {
            steps {
                echo 'Stopping Old Containers'
                sh '''
                docker compose down || true
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                echo 'Deploying Application'
                sh '''
                docker compose up -d --build
                '''
            }
        }

        stage('Container Test') {
            steps {
                echo 'Checking Running Containers'
                sh '''
                docker ps
                '''
            }
        }

        stage('Backend API Test') {
            steps {
                echo 'Testing Backend API'
                sh '''
                sleep 15
                curl -f http://54.167.193.212:5000/ || true
                '''
            }
        }

        stage('Database Connection Test') {
            steps {
                echo 'Database Connection Test'
                sh '''
                docker compose ps
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline Finished'
        }

        success {
            echo '✅ Pipeline Successful'
        }

        failure {
            echo '❌ Pipeline Failed'
            sh '''
            docker compose logs --tail 100 || true
            '''
        }
    }
}
